{
  "name": "hs-code-classifier-backend",
  "version": "1.0.0",
  "description": "Backend API for HS Code Classification using hybrid AI approach",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:intelligent": "npx ts-node src/tests/intelligent-test-suite/test-runner.ts",
    "test:comprehensive": "npx ts-node src/tests/runners/comprehensive-test-runner.ts",
    "test:integration": "npx ts-node src/tests/integration-test.ts",
    "test:notes-accessor": "npx ts-node src/tests/audit/chapter-notes-accessor-test.ts",
    "test:baseline:before": "npx ts-node src/tests/baseline/run-baseline.ts",
    "test:baseline:after": "npx ts-node src/tests/baseline/run-baseline.ts --after",
    "test:baseline:compare": "npx ts-node src/tests/baseline/compare-results.ts",
    "test:integration:notes": "npx ts-node src/tests/integration/pipeline-notes-integration.test.ts",
    "generate:tier2": "npx ts-node src/tests/test-data/tier2-database/generate-tier2.ts",
    "generate:tier3": "npx ts-node src/tests/test-data/tier3-llm/generate-tier3.ts",
    "merge:tiers": "npx ts-node src/tests/test-data/merge-tiers.ts",
    "eval": "npx tsx --require dotenv/config src/eval/runner.ts",
    "eval:quick": "npx tsx --require dotenv/config src/eval/runner.ts --suite quick",
    "eval:compare": "npx tsx src/eval/compare.ts",
    "gt-fix": "npx tsx src/eval/gt-fix/run-all.ts",
    "gt-fix:invalid": "npx tsx --require dotenv/config src/eval/gt-fix/fix-invalid-codes.ts",
    "gt-fix:missing": "npx tsx --require dotenv/config src/eval/gt-fix/fix-missing-gt.ts",
    "gt-fix:llm": "npx tsx --require dotenv/config src/eval/gt-fix/flag-llm-cases.ts",
    "gt-fix:merge": "npx tsx src/eval/gt-fix/merge-and-review.ts"
  },
  "keywords": [
    "hs-code",
    "classification",
    "export",
    "ai",
    "customs"
  ],
  "author": "Aryan",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.86.0",
    "@types/pg": "^8.15.6",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "fastest-levenshtein": "^1.0.16",
    "natural": "^8.1.0",
    "openai": "^4.67.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.394",
    "pg": "^8.16.3",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.2.4",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
