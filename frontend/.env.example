# =============================================================================
# Prevyl frontend — environment reference
# =============================================================================
# Copy to `.env.local` and fill in only what you need. EVERYTHING here is
# OPTIONAL. With NONE of these set, the app runs fully on the built-in mock
# backend, with guest storage in the browser's localStorage. No external
# service is contacted and nothing throws.
# =============================================================================

# --- Backend ---------------------------------------------------------------
# Real classifier backend base URL. UNSET = use the built-in deterministic mock.
BACKEND_API_URL=
# Artificial delay (ms) the mock waits before responding, to feel real. Default 2600.
MOCK_DELAY_MS=2600

# --- Site ------------------------------------------------------------------
# Public site origin, used for permalinks and OG image URLs. e.g. https://hscode.prevyl.com
NEXT_PUBLIC_SITE_URL=

# --- Supabase (auth + saved records) ---------------------------------------
# UNSET = accounts/DB disabled; records stay in localStorage. Auth UI shows "coming soon".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key (never exposed to the browser). Used for privileged writes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (cost protection / bot check) --------------------
# UNSET = the Turnstile widget renders nothing (no-op). Set both to enable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cost ceiling ----------------------------------------------------------
# Global daily free-classification ceiling (shared across all users). Default 200.
NEXT_PUBLIC_DAILY_CEILING=200

# --- Observability (optional) ----------------------------------------------
# Sentry DSN for error reporting. UNSET = no error reporting.
SENTRY_DSN=
